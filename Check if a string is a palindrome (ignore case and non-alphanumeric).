#include<stdio.h>
#include<string.h>
#include<ctype.h>
int palindrome(char str[])
{
    int i=0;
    int j=strlen(str)-1;
    while(i<j)
    {
        while(i<j&&!isalnum(str[i])) i++;
        while(i<j&&!isalnum(str[j]))j--;
        if(tolower(str[i])!=tolower(str[j]))
        {
            return 0;
        }
        i++;
        j--;
    }
    return 1;
}
int main()
{
    char str[1000];
    fgets(str,sizeof(str),stdin);
    if(palindrome(str))
    printf("Palindrome");
    else
    printf("Not a Palindrome");
    return 0;
}
