#include<stdio.h>
int main()
{
    char str[1000],ch;
    int j=0;
    fgets(str,sizeof(str),stdin);
    scanf("%c",&ch);
    for(int i=0;str[i]!='\0';i++)
    {
        if(str[i]!=ch&&str[i]!='\n')
        {
            str[j]=str[i];
            j++;
        }
    }
    str[j]='\0';
    printf("%s",str);
}
